# --- Discord ---
DISCORD_TOKEN=coloca_aqui_el_token_del_bot
LEADS_CHANNEL_ID=coloca_aqui_el_id_del_canal
COMMAND_PREFIX=!

# --- Extracción de números ---
# País por defecto cuando el número no trae código de país (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=VE

# --- WhatsApp checker (Baileys) ---
# Carpeta donde se guarda la sesión de WhatsApp (credenciales). No la subas a git.
WA_AUTH_DIR=baileys_auth

# Opcional: si quieres vincular por código en vez de escanear QR, pon aquí
# el número de la cuenta de WhatsApp que hará de "verificador", con código
# de país y sin '+' ni espacios (ej: 584141234567).
WA_PAIRING_PHONE_NUMBER=

# Tamaño de lote y pausa entre lotes al consultar WhatsApp (mitiga rate-limit)
WA_CHECK_BATCH_SIZE=20
WA_CHECK_BATCH_DELAY_MS=1500

# Nivel de log de Baileys: silent | error | warn | info | debug
WA_LOG_LEVEL=silent

# --- Discord output ---
# Largo máximo antes de mandar el reparto como archivo adjunto en vez de mensaje
DISCORD_MAX_MESSAGE_LENGTH=1900
